# ---------------------------------------------------------------------------
# Python 3.15 source-build workaround (last checked 2026-11-09 against PyPI)
#
# The image runs on Python 3.15. Two dependencies still publish no cp315
# wheels, so the Dockerfile's builder stage uses the full (non-slim)
# python:3.15 image, which has a C toolchain, and compiles them from sdist.
# The runtime stage is still python:3.15-slim; only the built venv is copied.
# Re-check on each re-lock and delete an entry once its wheels ship:
#
#   PyYAML 6.0.3     No cp315 wheel (3.15 wheel builds merged upstream,
#                    awaiting a release). Built with PYYAML_FORCE_LIBYAML=0
#                    because the slim runtime has no libyaml; the config loader
#                    uses the pure-Python SafeLoader anyway.
#   zstandard 0.25.0 No cp315 wheel (open 3.15 wheel/support PRs upstream).
#
# Once BOTH ship cp315 wheels the workaround is no longer needed: switch the
# Dockerfile builder back to `python:${PYTHON_VERSION}-slim`, drop
# PYYAML_FORCE_LIBYAML, and delete this note. (CI is unaffected either way:
# GitHub runners have a compiler.)
# ---------------------------------------------------------------------------

# MCP server framework (FastMCP v4 + streamable-http transport).
# fastmcp depends on the `mcp` SDK, so it is pulled in transitively. 4.1.0 is
# the first release that declares Python 3.15 support.
fastmcp>=4.1.0
starlette>=1.7.0
uvicorn>=0.54.0

# Config / settings. The whole server is configured from one YAML file
# (config.example.yaml); PyYAML parses it and pydantic validates every value at
# startup. Explicit dependency on PyYAML: it currently arrives transitively via
# fastmcp, and an unpinned accidental removal would break startup.
pydantic>=2.13.5
PyYAML>=6.0.3

# Shared HTTP / async
httpx>=0.28.1
anyio>=4.15.1

# Content-Encoding decoders. httpx only decodes (and only advertises in its
# Accept-Encoding) the compression schemes it can import: with these installed it
# adds Brotli ("br") and Zstandard ("zstd"). Many CDNs return those, and
# advertising the full set real browsers send makes a direct fetch look less like
# a bot, so fewer pages fall through to the FlareSolverr/Firecrawl fallbacks.
brotli>=1.2.1
zstandard>=0.25.0

