# ---------------------------------------------------------------------------
# Python 3.15 blockers (last checked 2026-10-22 against PyPI releases)
#
# The code and full test suite pass on 3.15; what keeps the image and CI on
# 3.14 is packaging. Re-check these on each re-lock and delete an entry once
# it is resolved:
#
#   youtube-transcript-api 1.2.4  Declares Requires-Python "<3.15" (upstream
#       master is still capped). Works on 3.15 (verified with a live transcript
#       fetch), and uv ignores the cap so the Docker build installs it, but pip
#       refuses, which blocks the CI test job. Unblocked by a release that lifts
#       the cap.
#   PyYAML 6.0.3, zstandard 0.25.0  No cp315 wheels yet. Their sdists build
#       and pass on 3.15, but python:3.15-slim has no compiler, so the
#       Dockerfile builder stage fails. Unblocked by cp315 wheels (PyYAML has
#       merged 3.15 wheel builds, awaiting a release; zstandard has open 3.15
#       wheel/support PRs), or by installing gcc in the builder stage only.
#
# Cleared: beartype 0.23.1 (final) supports 3.15 and Requires-Python >=3.10, so
# the lock no longer pins a pre-release; fastmcp's `beartype>=0.23.0rc2` floor is
# satisfied by it everywhere. brotli 1.2.1 ships cp315 manylinux wheels for
# x86_64 and aarch64 (both image platforms).
# Once unblocked: build with `--build-arg PYTHON_VERSION=3.15` (Dockerfile),
# add "3.15" to the CI test matrix (.github/workflows/docker-publish.yml), and
# update the versions named in AGENTS.md.
# ---------------------------------------------------------------------------

# MCP server framework (FastMCP v4 + streamable-http transport).
# fastmcp depends on the `mcp` SDK, so it is pulled in transitively. 4.1.0 is
# the first release that declares Python 3.15 support.
fastmcp>=4.1.0
starlette>=1.7.0
uvicorn>=0.54.0

# Config / settings. The whole server is configured from one YAML file
# (config.example.yaml); PyYAML parses it and pydantic validates every value at
# startup. Explicit dependency on PyYAML: it currently arrives transitively via
# fastmcp, and an unpinned accidental removal would break startup.
pydantic>=2.13.5
PyYAML>=6.0.3

# Shared HTTP / async
httpx>=0.28.1
anyio>=4.15.1

# Content-Encoding decoders. httpx only decodes (and only advertises in its
# Accept-Encoding) the compression schemes it can import: with these installed it
# adds Brotli ("br") and Zstandard ("zstd"). Many CDNs return those, and
# advertising the full set real browsers send makes a direct fetch look less like
# a bot, so fewer pages fall through to the FlareSolverr/Firecrawl fallbacks.
brotli>=1.2.1
zstandard>=0.25.0

# Agentic Web Search
beautifulsoup4>=4.15.0
lxml>=6.1.3
markdownify>=1.2.3
# Timeout-capable regex engine for model-supplied fetch_page query patterns.
regex>=2026.9.29

