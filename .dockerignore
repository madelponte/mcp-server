# Keep the build context (and the resulting image) lean, and never bake host /
# dev / secret files into the published image. The server's deps come from
# requirements.txt; runtime configuration is a YAML file bind-mounted into the
# container: docker run -v "$PWD/config.yaml:/app/config.yaml:ro" ...

# Virtualenvs — host-specific; deps are reinstalled from requirements.txt
.venv/
venv/
ENV/

# Secrets / local config — NEVER copy into the image. config.yaml is mounted
# read-only at runtime; only the documented example belongs in the image.
.env
.env.*
config.yaml
config.yml
config.*.yaml
config.*.yml
!config.example.yaml

# Version control
.git/
.gitignore

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tests & dev-only tooling (not needed to run the server)
tests/
pytest.ini
.pytest_cache/
requirements-dev.txt

# Docs / CI / compose (not used inside the image)
README.md
AGENTS.md
.github/
docker-compose.yml
Dockerfile
.dockerignore
