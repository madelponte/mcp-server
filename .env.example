# =============================================================================
# MCP server — example configuration.
# Copy to `.env` and fill in values. Every variable here corresponds to an
# Open WebUI "valve" from the original tools (plus a few server-level options).
# All variables are optional unless noted; defaults are shown.
# =============================================================================

# ----------------------------- Server ---------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Transport: streamable-http (recommended, network accessible), sse, or stdio.
MCP_TRANSPORT=streamable-http
MCP_LOG_LEVEL=INFO
# Debug mode. When true, tools return indented, human-readable JSON (instead of
# the default compact JSON, which keeps results small in the model's context
# window) and log every tool call with its arguments to stdout. Forces the
# effective log level to DEBUG regardless of MCP_LOG_LEVEL. Leave false in
# production; turn on while developing or troubleshooting.
MCP_DEBUG=false
# Shared bearer token required on every HTTP request
# (Authorization: Bearer <token>). Leave blank to disable auth and leave the
# server open to anyone who can reach it. Ignored for the stdio transport.
# Generate a strong value, e.g.  openssl rand -hex 32
MCP_AUTH_TOKEN=

# ------------------------- Agentic Web Search --------------------------------
# Base URL of your SearXNG instance (no trailing /search). The bundled
# docker-compose runs one at this hostname.
WEB_SEARCH_SEARXNG_URL=http://searxng:8080
# MAXIMUM number of search results to return. The model picks how many it wants
# per call via the search_web `num_results` argument; this caps that request.
WEB_SEARCH_MAX_NUM_RESULTS=5
# MAXIMUM number of top results to fetch structured metadata (description +
# table-of-contents outline) for. The model picks how many to enrich per call
# via the search_web `enrich_results` argument; this caps that request so a
# pile of outlines can't overwhelm its context (0 disables enrichment entirely).
WEB_SEARCH_MAX_ENRICH_RESULTS=3
# Number of top results to enrich when the model doesn't pass `enrich_results`.
# Clamped to MAX_ENRICH_RESULTS above; 0 disables enrichment by default.
WEB_SEARCH_DEFAULT_ENRICH_RESULTS=2
WEB_SEARCH_SEARXNG_CATEGORIES=general
WEB_SEARCH_SEARXNG_LANGUAGE=en
# '', day, week, month, or year
WEB_SEARCH_SEARXNG_TIME_RANGE=
# 0=off, 1=moderate, 2=strict
WEB_SEARCH_SEARXNG_SAFESEARCH=0
# FlareSolverr base URL (no trailing /v1). Leave blank to disable the Cloudflare fallback.
WEB_SEARCH_FLARESOLVERR_URL=http://flaresolverr:8191
WEB_SEARCH_FLARESOLVERR_TIMEOUT_MS=60000
# Apache Tika server for document text extraction (PDF, Word, Excel,
# PowerPoint, OpenDocument, RTF, EPUB).
WEB_SEARCH_TIKA_URL=http://tika:9998
# Timeout for a single Tika extraction request, in seconds.
WEB_SEARCH_TIKA_TIMEOUT_SECONDS=90
# Tika PDF OCR strategy: no_ocr (fast, embedded text only) | auto |
# ocr_and_text_extraction | ocr_only. OCR modes handle scanned/image PDFs but
# are much slower (raise TIKA_TIMEOUT_SECONDS if you enable them).
WEB_SEARCH_TIKA_OCR_STRATEGY=no_ocr
WEB_SEARCH_HTTP_TIMEOUT_SECONDS=25
WEB_SEARCH_VERIFY_SSL=true
# fetch_page refuses URLs whose host resolves to a non-public address (loopback,
# private, link-local — blocks SSRF to localhost/cloud-metadata/LAN). To let it
# reach a trusted local/private page you host, allowlist hosts/IPs/CIDRs here
# (comma/space-separated). Applies to redirect targets too. Empty = block all.
# WEB_SEARCH_SSRF_ALLOWLIST=localhost,127.0.0.1,192.168.1.50,10.0.0.0/8
# Cache fetched pages this many seconds so an agent loop that re-fetches the same
# URL skips the network round-trip (0 disables). Bounds memory by entry count.
WEB_SEARCH_CACHE_TTL_SECONDS=300
WEB_SEARCH_CACHE_MAX_ENTRIES=128
# WEB_SEARCH_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
# fetch_page's text mode returns the page as markdown (headings, lists, tables,
# and absolute hyperlinks preserved). Set false for plain-text extraction.
WEB_SEARCH_MARKDOWN=true
WEB_SEARCH_MAX_PAGE_CHARS=25000
WEB_SEARCH_MAX_ENRICH_HEADINGS=25
WEB_SEARCH_MAX_SNIPPET_CHARS=400
# fetch_page's optional `query` returns only the passages matching a keyword/regex,
# each with this many surrounding segments (paragraphs / transcript lines) of
# context on either side, up to this many distinct match windows per response.
WEB_SEARCH_QUERY_CONTEXT_SEGMENTS=2
WEB_SEARCH_MAX_QUERY_MATCHES=10

# ----------------------------- Stock Data ------------------------------------
# Finnhub is the recommended primary provider (free key, 60 calls/min).
STOCK_FINNHUB_API_KEY=
# Optional — enables deep financial statements via Financial Modeling Prep.
STOCK_FMP_API_KEY=
# auto | finnhub | yfinance | fmp
STOCK_DEFAULT_PROVIDER=auto
# auto | fmp | yfinance | finnhub
STOCK_FINANCIALS_PROVIDER=auto
STOCK_PREFER_YFINANCE_FALLBACK=true
STOCK_REQUEST_TIMEOUT=15
# Cache responses this many seconds (0 disables).
STOCK_CACHE_TTL_SECONDS=60
# The STOCK_MAX_* values below are upper bounds, not fixed amounts. get_company_data
# lets the model request a smaller range per call (periods / news_items / insider_weeks);
# anything larger is clamped to these caps so a response can't blow up its context window.
# Omitting an amount in the call uses the cap.
STOCK_MAX_NEWS_ITEMS=5
# Max periods for the financials section (income/balance/cashflow).
STOCK_MAX_FINANCIAL_PERIODS=4
# Max periods for the earnings section.
STOCK_MAX_EARNINGS_PERIODS=8
# Max weeks of insider buying/selling the "insiders" section can look back on.
STOCK_MAX_INSIDER_LOOKBACK_WEEKS=12
# Max daily OHLC bars the "history" section can return.
STOCK_MAX_HISTORY_BARS=30

# ---------------------------- Wolfram Alpha ----------------------------------
# Required for the Wolfram tool. Get a free AppID at https://developer.wolframalpha.com
WOLFRAM_APP_ID=
# metric | nonmetric
WOLFRAM_DEFAULT_UNITS=metric
WOLFRAM_MAX_CHARS=6800
# HTTP timeout for the Wolfram Alpha request, in seconds.
WOLFRAM_HTTP_TIMEOUT_SECONDS=30
# Cache results this many seconds so a re-asked computation skips the network
# round-trip. Results are deterministic per (input, assumption, units), so a long
# TTL is safe (0 disables the cache).
WOLFRAM_CACHE_TTL_SECONDS=3600
WOLFRAM_CACHE_MAX_ENTRIES=256

# ------------------------- YouTube Transcript --------------------------------
# Comma-separated language codes to try, in priority order.
YOUTUBE_DEFAULT_LANGUAGES=en
YOUTUBE_INCLUDE_TIMESTAMPS=false
# Truncate transcript to this many characters (0 = no limit).
YOUTUBE_MAX_CHARACTERS=0
# Cache transcripts this many seconds (0 disables). Transcripts almost never
# change, so a long TTL (default 24h) is safe and avoids re-fetching.
YOUTUBE_CACHE_TTL_SECONDS=86400
YOUTUBE_CACHE_MAX_ENTRIES=256
# Optional residential proxy (needed if YouTube blocks the server IP, common on cloud hosts).
YOUTUBE_WEBSHARE_PROXY_USERNAME=
YOUTUBE_WEBSHARE_PROXY_PASSWORD=
# Generic HTTP/SOCKS proxy URL, used only if the Webshare fields above are empty.
YOUTUBE_HTTP_PROXY_URL=

# --------------------- Geocoding & Place Search (OSM) ------------------------
# Backends. Defaults use the public OpenStreetMap APIs. To self-host, point these
# at your own deployments (and set GEO_MIN_REQUEST_INTERVAL_SECONDS=0 below).
GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Nominatim's usage policy REQUIRES a descriptive User-Agent identifying your app
# (a generic browser UA is not allowed). Customize this — ideally with contact info.
GEO_USER_AGENT=openwebui-tools-mcp/1.0 (OpenStreetMap geocoding; +https://github.com/madelponte/mcp-server)
# Optional contact email passed to Nominatim (recommended by the usage policy).
GEO_NOMINATIM_EMAIL=
# Preferred result language (sent as Accept-Language).
GEO_LANGUAGE=en
GEO_HTTP_TIMEOUT_SECONDS=20
GEO_OVERPASS_TIMEOUT_SECONDS=30
# Minimum seconds between Nominatim calls. The public API caps at ~1/sec, so we
# serialize and space requests. Set to 0 to disable when self-hosting.
GEO_MIN_REQUEST_INTERVAL_SECONDS=1
# The GEO_MAX_* / GEO_DEFAULT_* values are caps + defaults. The model can request
# fewer per call; anything larger is clamped so a response can't blow up context.
GEO_MAX_NEARBY_RESULTS=20
GEO_DEFAULT_NEARBY_RESULTS=8
# Search radius (meters) for nearby queries: default when unspecified, and the cap.
GEO_DEFAULT_RADIUS_M=1500
GEO_MAX_RADIUS_M=20000
# Safety cap on elements fetched from Overpass before sorting by distance and
# trimming to the requested count (bounds the response in dense areas).
GEO_OVERPASS_MAX_ELEMENTS=120
# Cache results this many seconds (0 disables). Place data changes slowly, so a
# long TTL is safe and helps honor the public APIs' rate limits.
GEO_CACHE_TTL_SECONDS=86400
GEO_CACHE_MAX_ENTRIES=256
